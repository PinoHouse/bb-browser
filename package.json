{
  "name": "@pinix/browser",
  "version": "0.11.0",
  "description": "Codex Plugin for session-safe control of the user's signed-in Chrome.",
  "type": "module",
  "bin": {
    "bb-browser-mcp": "./dist/mcp.js"
  },
  "main": "./dist/mcp.js",
  "files": [
    ".codex-plugin",
    ".mcp.json",
    ".agents/plugins",
    "bin/bb-browser-mcp",
    "dist",
    "extension",
    "skills",
    "scripts/install-native-host.mjs",
    "scripts/uninstall-native-host.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "turbo run build && pnpm build:release",
    "build:release": "tsup && pnpm build:extension",
    "build:extension": "rm -rf extension && cp -r packages/extension/dist extension",
    "install:native-host": "node scripts/install-native-host.mjs",
    "uninstall:native-host": "node scripts/uninstall-native-host.mjs",
    "test:native-host-install": "pnpm build:release && node --test scripts/native-host-install.test.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm build:release && node --test scripts/native-host-install.test.mjs",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules dist extension",
    "prepublishOnly": "pnpm build:release"
  },
  "keywords": [
    "browser",
    "automation",
    "ai",
    "agent",
    "chrome",
    "extension",
    "native-messaging",
    "codex-plugin",
    "mcp"
  ],
  "author": "PinoHouse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinoHouse/bb-browser.git"
  },
  "bugs": {
    "url": "https://github.com/PinoHouse/bb-browser/issues"
  },
  "homepage": "https://github.com/PinoHouse/bb-browser#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0"
  }
}
