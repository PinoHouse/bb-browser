{
  "manifest_version": 3,
  "name": "bb-browser",
  "version": "0.11.0",
  "description": "Browser automation for AI agents",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "history",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/trace.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "buildDomTree.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
